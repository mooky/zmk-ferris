    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = < 26 27 28 29 >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = < 20 21 22 23 >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <2 1 2>;
        };

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 10>;
            layers = <0>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <10 20>;
            layers = <0>;
        };

        combo_ins {
            bindings = <&kp INS>;
            key-positions = <1 11>;
            layers = <0>;
        };

        combo_del {
            bindings = <&kp DEL>;
            key-positions = <11 21>;
            layers = <0>;
        };

        combo_pgup {
            bindings = <&kp PAGE_UP>;
            key-positions = <2 12>;
            layers = <0>;
        };

        combo_pgdn {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <12 22>;
            layers = <0>;
        };

        combo_numword {
            bindings = <&num_word 1>;
            key-positions = <3 13>;
            layers = <0>;
        };

        combo_capsword {
            bindings = <&caps_word>;
            key-positions = <13 23>;
            layers = <0>;
        };

        combo_left {
            bindings = <&kp LEFT>;
            key-positions = <26 16>;
            layers = <0>;
        };

        combo_up {
            bindings = <&kp UP_ARROW>;
            key-positions = <7 17>;
            layers = <0>;
        };

        combo_down {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <17 27>;
            layers = <0>;
        };

        combo_right {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <18 28>;
            layers = <0>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <19 29>;
            layers = <0>;
        };

        combo_single {
            bindings = <&kp SQT>;
            key-positions = <9 19>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W        &kp E         &kp R         &kp T                   &kp Y            &kp U         &kp I             &kp O          &kp P
&lt 2 A      &lt 5 S      &lt 4 D       &lt 1 F       &kp G                   &kp H            &lt 1 J       &lt 4 K           &lt 5 L        &lt 2 SEMI
&hml LGUI Z  &hml LALT X  &hml LCTRL C  &hml LSHFT V  &kp B                   &kp N            &hmr RSHFT M  &hmr RCTRL COMMA  &hmr RALT DOT  &hmr RGUI FSLH
                                        &lt 3 TAB     &mt LEFT_SHIFT SPACE    &mt LCTRL ENTER  &lt 1 BSPC
            >;
        };

        ext {
            bindings = <
&kp GRAVE  &kp INS  &kp PAGE_UP    &none       &bootloader    &bootloader  &none     &none     &none      &kp INS
&kp TAB    &kp DEL  &kp PAGE_DOWN  &caps_word  &none          &none        &kp LEFT  &kp UP    &kp RIGHT  &kp RET
&none      &none    &none          &none       &none          &none        &kp HOME  &kp DOWN  &kp END    &kp DEL
                                   &trans      &trans         &trans       &trans
            >;

            label = "ext";
        };

        num {
            bindings = <
&none         &kp PLUS   &kp N5  &kp N6  &none     &none   &kp N7  &kp N8  &kp N9  &none
&kp ASTERISK  &kp MINUS  &kp N0  &kp N1  &none     &none   &kp N2  &kp N3  &kp N4  &kp EQUAL
&none         &none      &none   &none   &none     &none   &none   &none   &none   &none
                                 &trans  &trans    &trans  &trans
            >;

            label = "number";
        };

        tri_layer {
            bindings = <
&sys_reset   &trans  &trans  &trans          &bt BT_SEL 0    &trans  &trans  &trans  &trans  &sys_reset
&bootloader  &trans  &trans  &studio_unlock  &bt BT_SEL 1    &trans  &trans  &trans  &trans  &bootloader
&trans       &trans  &trans  &bt BT_CLR      &bt BT_SEL 2    &trans  &trans  &trans  &trans  &trans
                             &trans          &trans          &trans  &trans
            >;
        };

        sym {
            bindings = <
&none      &kp PRCNT  &kp PIPE  &kp BSLH  &none       &none   &kp RPAR  &kp RBRC  &kp RBKT  &none
&kp CARET  &kp HASH   &kp EXCL  &kp FSLH  &kp DLLR    &none   &kp LPAR  &kp LBRC  &kp LBKT  &kp SQT
&none      &none      &none     &none     &none       &none   &none     &none     &none     &none
                                &trans    &trans      &trans  &trans
            >;
        };

        fun {
            bindings = <
&none  &kp F7  &kp F8  &kp F9  &none     &none   &kp F10  &kp F11  &kp F12  &none
&none  &kp F1  &kp F2  &kp F3  &none     &none   &kp F4   &kp F5   &kp F6   &none
&none  &none   &none   &none   &none     &none   &none    &none    &none    &none
                       &trans  &trans    &trans  &trans
            >;
        };
    };
};
